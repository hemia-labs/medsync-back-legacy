# Fragmento de correo SES DEV. Copiar estas variables a .env.local conservando
# el resto de la configuracion existente. El loader no carga .env.medsync.dev.
# Las credenciales reales se entregan en privado y nunca se versionan.
# AWS_REGION y las claves tambien las consume S3 legacy. No reemplazar una
# configuracion S3 operativa sin validar compatibilidad de region/permisos.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales:
AWS_SESSION_TOKEN=

EMAIL_PROVIDER=ses
EMAIL_PROJECT=medsync
EMAIL_ENVIRONMENT=dev
EMAIL_FROM_NAME=MedSync
EMAIL_FROM_AUTH=auth@medsync.hemia.dev
EMAIL_FROM_NOTIFICATIONS=notifications@medsync.hemia.dev
# Confirmar que este buzon atiende respuestas de MedSync:
EMAIL_REPLY_TO=support@hemia.dev
EMAIL_CONFIGURATION_SET_AUTH=hemia-dev-auth
EMAIL_CONFIGURATION_SET_TRANSACTIONAL=hemia-dev-transactional
EMAIL_PASSWORD_RESET_TEMPLATE=medsync-dev-password-reset-code
EMAIL_PASSWORD_CHANGE_CODE_TEMPLATE=medsync-dev-password-change-code
EMAIL_PASSWORD_CHANGED_TEMPLATE=medsync-dev-password-changed
EMAIL_DOCUMENT_SIGNATURE_TEMPLATE=medsync-dev-document-signature

# El enlace de firma se genera con la configuracion ya existente del frontend.
# En desarrollo, SES también acepta el origen loopback HTTP de PUBLIC_APP_URL.
# S3 se configura por separado; este cambio no migra objetos ni buckets.

# S24 self-registration: closed until migrations, legal publication and email are ready.
REGISTRATION_ENABLED=false
REGISTRATION_IDENTITY_ENABLED=false
REGISTRATION_EMAIL_ENABLED=false
# 32-byte secret encoded as 64 hex characters; provision outside source control.
REGISTRATION_HMAC_KEY=
# One confidential backend client; never copy these values to the frontend.
HEMIA_ID_URL=http://localhost:4000
HEMIA_CLIENT_ID=medsync-backend
HEMIA_CLIENT_SECRET=
LEGAL_API_URL=http://localhost:3017
LEGAL_APPLICATION_ID=
LEGAL_ACCOUNT_CATALOG_ENABLED=false
LEGAL_CONTEXT_CALLER_ID=
LEGAL_CONTEXT_AUDIENCE=
LEGAL_CONTEXT_INTROSPECTION_URL=
# Exact HTTPS origins of Legal's published HTML artifacts, comma-separated.
LEGAL_DOCUMENT_ORIGINS=
# Versioned local JSON blocklist and its SHA-256; no demo list for release.
REGISTRATION_PASSWORD_BLOCKLIST_PATH=
REGISTRATION_PASSWORD_BLOCKLIST_SHA256=
# SES only: separate published verification template, with code and ttlMinutes variables.
EMAIL_REGISTRATION_CODE_TEMPLATE=medsync-dev-registration-contact-code-v1
# SES only: published welcome template. The /login link uses PUBLIC_APP_URL.
EMAIL_REGISTRATION_WELCOME_TEMPLATE=medsync-dev-registration-welcome
# Existing SMTP/SES sender configuration is reused. No SMS provider is required.
# Legacy flag; email activation now follows REGISTRATION_IDENTITY_ENABLED.
# Registration requires the s24-registration-activation schema.
REGISTRATION_ACTIVATION_ENABLED=false

# Private clinic logos and professional signatures; previews expire after 300 seconds.
S3_PRIVATE_BUCKET=medsync-prod
