# Fragmento de correo SES DEV. Copiar estas variables a .env.local conservando
# el resto de la configuracion existente. El loader no carga .env.medsync.dev.
# Las credenciales reales se entregan en privado y nunca se versionan.
# AWS_REGION y las claves tambien las consume S3 legacy. No reemplazar una
# configuracion S3 operativa sin validar compatibilidad de region/permisos.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales:
AWS_SESSION_TOKEN=

EMAIL_PROVIDER=ses
EMAIL_PROJECT=medsync
EMAIL_ENVIRONMENT=dev
EMAIL_FROM_NAME=MedSync
EMAIL_FROM_AUTH=auth@medsync.hemia.dev
EMAIL_FROM_NOTIFICATIONS=notifications@medsync.hemia.dev
# Confirmar que este buzon atiende respuestas de MedSync:
EMAIL_REPLY_TO=support@hemia.dev
EMAIL_CONFIGURATION_SET_AUTH=hemia-dev-auth
EMAIL_CONFIGURATION_SET_TRANSACTIONAL=hemia-dev-transactional
EMAIL_PASSWORD_RESET_TEMPLATE=medsync-dev-password-reset-code
EMAIL_PASSWORD_CHANGE_CODE_TEMPLATE=medsync-dev-password-change-code
EMAIL_PASSWORD_CHANGED_TEMPLATE=medsync-dev-password-changed
EMAIL_DOCUMENT_SIGNATURE_TEMPLATE=medsync-dev-document-signature

# El enlace de firma se genera con la configuracion ya existente del frontend.
# En desarrollo, SES también acepta el origen loopback HTTP de PUBLIC_APP_URL.
# S3 se configura por separado; este cambio no migra objetos ni buckets.

# S24 self-registration: closed until migrations, legal publication and email are ready.
REGISTRATION_ENABLED=false
REGISTRATION_IDENTITY_ENABLED=false
REGISTRATION_EMAIL_ENABLED=false
# 32-byte secret encoded as 64 hex characters; provision outside source control.
REGISTRATION_HMAC_KEY=
# One confidential backend client; never copy these values to the frontend.
HEMIA_ID_URL=http://localhost:4000
HEMIA_CLIENT_ID=medsync-backend
HEMIA_CLIENT_SECRET=
LEGAL_API_URL=http://localhost:3017
LEGAL_APPLICATION_ID=
# Keep registration in TEST; use a distinct published set for an isolated production integration.
LEGAL_REGISTRATION_SET_KEY=registration
LEGAL_ACCOUNT_CATALOG_ENABLED=false
LEGAL_CONTEXT_CALLER_ID=
LEGAL_CONTEXT_AUDIENCE=
LEGAL_CONTEXT_INTROSPECTION_URL=
# Exact HTTPS origins of Legal's published HTML artifacts, comma-separated.
LEGAL_DOCUMENT_ORIGINS=
# Versioned local JSON blocklist and its SHA-256; no demo list for release.
REGISTRATION_PASSWORD_BLOCKLIST_PATH=
REGISTRATION_PASSWORD_BLOCKLIST_SHA256=
# SES only: separate published verification template, with code and ttlMinutes variables.
EMAIL_REGISTRATION_CODE_TEMPLATE=medsync-dev-registration-contact-code-v1
# SES only: shared trial/paid-plan welcome template; paid delivery requires the outbox migration.
# The /login link uses PUBLIC_APP_URL. Billing must provide a confirmed initial payment.
EMAIL_REGISTRATION_WELCOME_TEMPLATE=medsync-dev-registration-welcome
# Existing SMTP/SES sender configuration is reused. No SMS provider is required.
# Legacy flag; email activation now follows REGISTRATION_IDENTITY_ENABLED.
# Registration requires the s24-registration-activation schema.
REGISTRATION_ACTIVATION_ENABLED=false

# Private clinic logos and professional signatures; previews expire after 300 seconds.
S3_PRIVATE_BUCKET=medsync-prod

# Payments SDK Node: configuración local de desarrollo. Las credenciales permanecen
# en HEMIA_CLIENT_ID/HEMIA_CLIENT_SECRET del backend; nunca en variables VUE_APP_*.
# El clientId del JSON debe coincidir con HEMIA_CLIENT_ID. En producción usar los
# destinos publicados para ese entorno y HTTPS; no reutilizar este JSON local.
PAYMENTS_CONNECTION={"baseUrl":"http://localhost:3015/api/v1","issuer":"http://localhost:4000","tokenUrl":"http://localhost:4000/oauth/token","clientId":"medsync-backend","resource":"http://localhost:3015","audience":"billing-api","productCode":"medsync","allowHttpLoopback":true,"successUrl":"http://localhost:8080/cuenta/planes","cancelUrl":"http://localhost:8080/cuenta/planes","legal":{"baseUrl":"http://localhost:3017","resource":"http://localhost:3017","audience":"legal-api","verificationClientId":"legal-service-dev"},"receiver":{"audience":"medsync-api","billingClientId":"billing-legal-service"}}

# NC3: control de integridad de notas firmadas. La clave NO va en la base de datos ni en el repositorio.
# Formato: id:hex(>=64 caracteres) separados por coma. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVOLUTION_INTEGRITY_KEYS=
EVOLUTION_INTEGRITY_KEY_ID=
# Instante UTC de la migracion/despliegue (ISO 8601). Filas posteriores sin asiento se tratan como discrepancia.
EVOLUTION_INTEGRITY_ADOPTION_AT=
# Opcional: ruta del ancla externa (por defecto logs/evolution-integrity-anchor.jsonl).
EVOLUTION_INTEGRITY_ANCHOR_PATH=

# NC3/C22: referencia externa (testigo de solo-agregar fuera de MySQL y de este servidor). Sin URL el conciliador no corre.
EVOLUTION_INTEGRITY_WITNESS_URL=
EVOLUTION_INTEGRITY_WITNESS_ENV=
# Token que SOLO agrega referencias (lo usa la aplicacion) y token de Soporte que lee e historiza incidentes.
EVOLUTION_INTEGRITY_WITNESS_WRITE_TOKEN=
EVOLUTION_INTEGRITY_WITNESS_SUPPORT_TOKEN=
# La cola de referencias pendientes vive en MySQL (tabla evolution_integrity_delivery, migracion nc3-evolution-integrity-delivery.sql).
# Periodo del conciliador (ms, por defecto 300000) y espera inicial de los reintentos (ms; crece x2 con tope de 5 min para referencias y 15 min para avisos).
EVOLUTION_INTEGRITY_DELIVERY_BACKOFF_MS=
EVOLUTION_INTEGRITY_ALERT_BACKOFF_MS=
# Cola durable de incidentes para Soporte (archivo del servidor, fuera de MySQL). Por defecto logs/evolution-integrity-incident-outbox.json.
EVOLUTION_INTEGRITY_INCIDENT_OUTBOX=
EVOLUTION_INTEGRITY_RECONCILE_MS=
# Canal de aviso a Soporte (webhook JSON sin texto clinico). Sin canal, el aviso queda en el registro del servidor.
EVOLUTION_INTEGRITY_ALERT_WEBHOOK_URL=
