{
  "name": "medsync-back",
  "version": "0.0.3",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "migration:history-base": "node scripts/migrations/clinical-history-base-template.js",
    "qa:history-base": "node --test scripts/qa/history-base-template.test.js",
    "qa:history-base-mysql": "node scripts/qa/history-base-template-mysql.js",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --offline --no-audit --no-fund",
    "qa:platform-sso": "node --test scripts/qa/platform-sso.test.js",
    "qa:payments": "node --test scripts/qa/payments.test.js scripts/qa/payments-license.test.js scripts/qa/payments-welcome.test.js scripts/qa/payments-checkout-legal.test.js scripts/qa/payments-updates.test.js scripts/qa/payments-plan-change.test.js scripts/qa/payments-history.test.js",
    "qa:payments-local": "node scripts/qa/payments-local-preflight.js",
    "qa:platform-sso-mysql": "node --test scripts/qa/platform-sso-mysql.test.js",
    "dev": "npm run dev:d2",
    "dev:d2": "node scripts/dev-auth-mode.js d2",
    "dev:legacy": "node scripts/dev-auth-mode.js legacy",
    "start": "node src/index.js",
    "qa:security-auth-cookies": "node scripts/qa/security-auth-cookies-whitebox-audit.js",
    "qa:authz-fase0": "node scripts/qa/authz-fase0-regression.js",
    "qa:security-idor": "node scripts/qa/security-multitenant-idor-suite.js",
    "qa:security-headers": "node scripts/qa/security-headers-http-regression.js",
    "qa:super-admin-dashboard": "node scripts/qa/super-admin-dashboard-regression.js",
    "migration:auth-password-change": "node scripts/migrations/apply-auth-password-change-tokens.js",
    "qa:isolated": "node scripts/qa/run-isolated-regressions.js",
    "qa:registration-legal": "bash scripts/qa/registration-legal.docker.sh",
    "qa:registration-http": "bash scripts/qa/registration-http.docker.sh",
    "qa:issues-mysql": "node scripts/qa/issues-mysql-regression.js",
    "qa:nc4-catalogs": "node --test scripts/qa/nc4-catalogs.test.js scripts/qa/nc4-clues-source.test.js",
    "qa:nc4-catalogs-mysql": "bash scripts/qa/nc4-catalogs.docker.sh",
    "qa:nc4-clues-mysql": "bash scripts/qa/nc4-catalogs.docker.sh mysql:8.4 clues-sync",
    "migration:nc1-login-surnames": "node scripts/migrations/nc1-login-surnames.js",
    "qa:nc5-chat": "node --test scripts/qa/nc5-chat.test.js",
    "qa:nc5-chat-mysql": "bash scripts/qa/nc5-chat.docker.sh",
    "migration:nc5-chat": "node scripts/migrations/nc5-internal-chat.js",
    "qa:nc3-integrity": "node --test scripts/qa/nc3-evolution-integrity.test.js",
    "qa:nc3-integrity-mysql": "bash scripts/qa/nc3-integrity.docker.sh",
    "qa:nc3-c22": "bash scripts/qa/nc3-c22.docker.sh",
    "nc3:witness": "node scripts/ops/nc3-witness-server.js",
    "nc3:incident": "node scripts/ops/nc3-incident.js",
    "qa:nc2-access-mysql": "bash scripts/qa/nc2-access-traceability.docker.sh"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "keywords": [
    "example",
    "heroku"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-sesv2": "3.1116.0",
    "@aws-sdk/lib-storage": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@hemia/auth": "1.1.0",
    "@hemia/legal": "0.1.0",
    "@hemia/payments": "file:vendor/hemia-payments-0.14.0.tgz",
    "axios": "1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "ejs": "^3.1.5",
    "express": "4.22.3",
    "express-session": "^1.17.1",
    "express-validator": "^6.9.2",
    "fs-extra": "^9.1.0",
    "http-errors": "~1.6.3",
    "jose": "6.2.14",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^3.1.2",
    "method-override": "^3.0.0",
    "morgan": "1.12.1",
    "mysql2": "3.24.6",
    "node-localstorage": "^2.1.6",
    "nodemailer": "10.2.1",
    "sanitize-html": "2.18.1",
    "sequelize": "6.37.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "acorn": "8.15.0",
    "nodemon": "3.1.14"
  },
  "overrides": {
    "sequelize": {
      "uuid": "$uuid"
    }
  }
}
