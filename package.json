{
  "name": "medsync-back",
  "version": "0.0.3",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --offline --no-audit --no-fund",
    "qa:platform-sso": "node --test scripts/qa/platform-sso.test.js",
    "qa:platform-sso-mysql": "node --test scripts/qa/platform-sso-mysql.test.js",
    "dev": "npm run dev:d2",
    "dev:d2": "node scripts/dev-auth-mode.js d2",
    "dev:legacy": "node scripts/dev-auth-mode.js legacy",
    "start": "node src/index.js",
    "qa:security-auth-cookies": "node scripts/qa/security-auth-cookies-whitebox-audit.js",
    "qa:authz-fase0": "node scripts/qa/authz-fase0-regression.js",
    "qa:security-idor": "node scripts/qa/security-multitenant-idor-suite.js",
    "qa:security-headers": "node scripts/qa/security-headers-http-regression.js",
    "qa:super-admin-dashboard": "node scripts/qa/super-admin-dashboard-regression.js",
    "migration:auth-password-change": "node scripts/migrations/apply-auth-password-change-tokens.js",
    "qa:isolated": "node scripts/qa/run-isolated-regressions.js",
    "qa:registration-legal": "bash scripts/qa/registration-legal.docker.sh",
    "qa:registration-http": "bash scripts/qa/registration-http.docker.sh",
    "qa:issues-mysql": "node scripts/qa/issues-mysql-regression.js",
    "qa:nc4-catalogs": "node --test scripts/qa/nc4-catalogs.test.js"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "keywords": [
    "example",
    "heroku"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-sesv2": "3.1116.0",
    "@aws-sdk/lib-storage": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@hemia/legal": "0.1.0",
    "axios": "1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "ejs": "^3.1.5",
    "express": "4.22.3",
    "express-session": "^1.17.1",
    "express-validator": "^6.9.2",
    "fs-extra": "^9.1.0",
    "http-errors": "~1.6.3",
    "jose": "6.2.14",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^3.1.2",
    "method-override": "^3.0.0",
    "morgan": "1.12.1",
    "mysql2": "3.24.6",
    "node-localstorage": "^2.1.6",
    "nodemailer": "10.2.1",
    "sanitize-html": "2.18.1",
    "sequelize": "6.37.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "nodemon": "3.1.14"
  },
  "overrides": {
    "sequelize": {
      "uuid": "$uuid"
    }
  }
}
